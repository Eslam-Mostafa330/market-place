APP_NAME=Marketplace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Frontend / CORS
# ----------------------------------------------------------------------------

# Origin of the SPA. Scheme and port are part of the origin and must match
# exactly - this is the single source for both CORS and origin enforcement.
FRONTEND_URL=http://localhost:5173

# How long browsers may cache a CORS preflight, in seconds.
CORS_MAX_AGE=7200

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Hosts whose requests are treated as the first-party SPA (cookie/session auth).
# Must list the SPA's host:port exactly — the port is significant. Requests from
# anywhere else fall back to bearer tokens (mobile clients).
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Mobile bearer token lifetimes.
ACCESS_TOKEN_EXPIRATION=60
REFRESH_TOKEN_EXPIRATION=30

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the cookie across subdomains (e.g. ".example.com"),
# which is what an api./app. split needs. Use "localhost" locally.
SESSION_DOMAIN=localhost
# Local development uses plain http, so Secure cookies would never be sent
# back. This MUST be true in production.
SESSION_SECURE_COOKIE=false
# Sanctum forces "lax" for stateful requests, so the SPA and the API have to
# share a registrable domain in production.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@marketplace.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Stripe
# ----------------------------------------------------------------------------

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Debugging
# ----------------------------------------------------------------------------

# Telescope stores every request, query and job — keep it off in production.
TELESCOPE_ENABLED=true
ACTIVITY_LOGGER_ENABLED=true
